# Copy to .env and fill in values
DATABASE_URL=postgresql+psycopg://tradefix_user:yourpassword@localhost:5432/tradefix
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated allowed if needed. Vercel preview URLs also match FRONTEND_ORIGIN_REGEX.
FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# Google OAuth (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Giphy (optional) — calendar screenshot GIF/sticker search
# GIPHY_API_KEY=

# Currency converter — delayed daily rates, proxied server-side (no client keys)
# FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
# FX_CACHE_TTL_SECONDS=900

# AI chat + scheduled agents. Never commit real keys.
# groq (default) or openrouter
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Optional fallback provider
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Optional. Leave empty to use lexical journal search without embeddings.
# OPENROUTER_EMBEDDING_MODEL=

# News questions use public Google News RSS. No extra API key.
# Application-level AI quotas (not OpenRouter limits)
# AI_DAILY_LIMIT=50
# AI_HOURLY_LIMIT=20
# AI_MAX_CONTEXT_DOCUMENTS=8
# AI_MAX_TRADE_RESULTS=100
# AI_MAX_TOOL_ITERATIONS=6
# AI_EMBEDDING_DIM=1536
# AI_MAX_HISTORY_MESSAGES=8
# ENABLE_SCHEDULER=true

# Broker credential keyring. 32-byte keys, base64, comma-separated. Never commit real values.
# BROKER_CREDENTIALS_KEYS=local:REPLACE_WITH_BASE64_32_BYTES
# BROKER_CREDENTIALS_ACTIVE_KEY=local
# Existing TradeFix-Connectors base URL, used only by the API worker. Leave empty to refuse MT connect.
# TRADEFIX_MT_BRIDGE_URL=
# TRADEFIX_MT_BRIDGE_TOKEN=
# BROKER_EGRESS_IP=
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_REDIRECT_URI=
# BROKER_WORKER_IN_PROCESS=true

# ---- Market data, Trade Replay and Backtesting (see README_BACKTESTING.md) ----
# Parquet candle store. MUST be persistent storage in production; losing it means re-running backfill.
# MARKET_DATA_DIR=market_data
# CANDLE_MAX_BARS_PER_REQUEST=5000
# CANDLE_REQUESTS_PER_MINUTE=120
# CANDLE_CACHE_MAX_ENTRIES=256
# Inline fetch (Binance REST only). Larger gaps, Dukascopy, timeouts and over-cap requests become jobs.
# INLINE_FETCH_MAX_GAP_MINUTES=4320
# INLINE_FETCH_TIMEOUT_S=8
# INLINE_FETCH_MAX_CONCURRENT=4
# CANDLE_OUTLIER_RANGE_MULTIPLE=20
# BINANCE_REST_HOSTS=https://api.binance.com,https://data-api.binance.vision
# BINANCE_FUTURES_REST_HOST=https://fapi.binance.com
# BINANCE_ARCHIVE_HOST=https://data.binance.vision
# BINANCE_REQUESTS_PER_SECOND=5
# Dukascopy data is documented for personal use. Disable before monetizing unless licensed.
# DUKASCOPY_ENABLED=true
# DUKASCOPY_PRICE_SIDE=bid
# DUKASCOPY_CHUNK_DAYS=7
# DUKASCOPY_TOOL_DIR=tools/dukascopy
# DUKASCOPY_REQUESTS_PER_SECOND=0.5
# DUKASCOPY_TIMEOUT_S=300
# Run the market worker inside the API process (dev). Production: `python -m app.workers.market_worker`.
# MARKET_WORKER_IN_PROCESS=false
# MARKET_WORKER_POLL_SECONDS=2
# Postgres advisory lock keys guaranteeing one market worker and one scheduler.
# MARKET_WORKER_LOCK_KEY=740001
# SCHEDULER_LOCK_KEY=740002
# WORKER_HEARTBEAT_STALE_SECONDS=60
# JOBS_MAX_CONCURRENT_BINANCE=2
# JOBS_MAX_CONCURRENT_DUKASCOPY=1
# JOBS_MAX_CONCURRENT_BACKTEST=2
# JOB_MAX_ATTEMPTS=5
# JOB_LOCK_SECONDS=300
# JOB_BACKOFF_BASE_SECONDS=15
# JOB_BACKOFF_MAX_SECONDS=900
# REPLAY_WINDOW_BARS_BEFORE=200
# REPLAY_WINDOW_BARS_AFTER=100
# REPLAY_SUGGESTED_START_BARS=100
# REPLAY_ALIGNMENT_TOLERANCE_PCT=0.05
# REPLAY_ALIGNMENT_TOLERANCE_PIPS=2
# Candidate zones for trade time-offset detection. NY_CLOSE = New York close server time (UTC+2/+3 with US DST).
# TIME_OFFSET_CANDIDATES=UTC,Etc/GMT-2,Etc/GMT-3,NY_CLOSE,Europe/London
# TIME_OFFSET_MIN_SAMPLE=5
# BACKTEST_MAX_BARS_PER_RUN=500000
# BACKTEST_RUNS_PER_DAY=30
# BACKTEST_MAX_CONCURRENT_PER_USER=1
# BACKTEST_MAX_STRATEGIES=50
# BACKTEST_MAX_SESSIONS=50
# BACKTEST_MAX_TRADES_PER_RUN=5000
# BACKTEST_TIME_LIMIT_S=120
# BACKTEST_CACHE_WINDOW_HOURS=24
# BACKTEST_EQUITY_POINTS=1000
# STRATEGY_MAX_CONDITIONS=10
# STRATEGY_MAX_INDICATORS=6
# INDICATOR_PERIOD_MIN=2
# INDICATOR_PERIOD_MAX=500
# TOPUP_UTC_HOUR=0
# TOPUP_UTC_MINUTE=35
# CROSSCHECK_TOLERANCE_PCT=0.1

# App identity, tokens and uploads
# APP_NAME=TradeFix
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# UPLOAD_DIR=uploads
# MAX_AVATAR_BYTES=2097152
# MAX_SCREENSHOT_BYTES=5242880
# MAX_RECAP_SCREENSHOTS=5

# Broker sync timing
# SYNC_JOB_TIMEOUT_SECONDS=3600
# SYNC_HEARTBEAT_SECONDS=15
# SYNC_DEFAULT_INTERVAL_MINUTES=15
# SYNC_RECONCILE_MINUTES=10
# SYNC_OVERLAP_MINUTES=30
