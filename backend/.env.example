# Copy to .env and fill in values
DATABASE_URL=postgresql+psycopg://tradefix_user:yourpassword@localhost:5432/tradefix
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated allowed if needed. Vercel preview URLs also match FRONTEND_ORIGIN_REGEX.
FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# Google OAuth (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Giphy (optional) — calendar screenshot GIF/sticker search
# GIPHY_API_KEY=

# Currency converter — delayed daily rates, proxied server-side (no client keys)
# FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
# FX_CACHE_TTL_SECONDS=900

# AI chat + scheduled agents. Never commit real keys.
# groq (default) or openrouter
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Optional fallback provider
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Optional. Leave empty to use lexical journal search without embeddings.
# OPENROUTER_EMBEDDING_MODEL=

# News questions use public Google News RSS. No extra API key.
# Application-level AI quotas (not OpenRouter limits)
# AI_DAILY_LIMIT=50
# AI_HOURLY_LIMIT=20
# AI_MAX_CONTEXT_DOCUMENTS=8
# AI_MAX_TRADE_RESULTS=100
# AI_MAX_TOOL_ITERATIONS=6
# AI_EMBEDDING_DIM=1536
# AI_MAX_HISTORY_MESSAGES=8
# ENABLE_SCHEDULER=true
